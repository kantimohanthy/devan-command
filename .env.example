# Public by design (RLS protects data). From Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The only email allowed into DEVAN (your own login email).
DEVAN_OWNER_EMAIL=you@example.com
# SERVER-ONLY secrets: set in Vercel, never commit, never prefix NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Never needed by the app. Do NOT add SUPABASE_SERVICE_ROLE_KEY here.
